<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the drop-in client against the game, as C# 6 and through the game's script whitelist,
    because a consumer compiles it into their own mod. It ships nothing and deploys nothing, so it
    takes MDK's references and analyzer and not its packager. ThermodynamicsClientTests checks that
    it binds the right table; this checks that it compiles at all.
  -->
  <PropertyGroup>
    <TargetFramework>netframework48</TargetFramework>
    <RootNamespace>ThermodynamicsModkit</RootNamespace>
    <LangVersion>6</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Platforms>x64</Platforms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ThermodynamicsApi.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.ModAnalyzers" Version="2.1.16">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mal.Mdk2.References" Version="2.2.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
